{
  "root": true,
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": "eslint:recommended",
  "rules": {
    "complexity": ["error", 10],
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "no-unused-vars": ["error", { "args": "after-used", "argsIgnorePattern": "^next$" }],
    "prefer-const": "error",
    "semi": ["error", "always"],
    "quotes": ["error", "single", { "avoidEscape": true }],
    "indent": ["error", 2, { "SwitchCase": 1 }],
    "no-console": "off"
  }
}
