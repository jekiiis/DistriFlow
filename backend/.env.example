# Sprint 0 environment template. Copy to backend/.env and fill with real values.
PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=distriflow

SESSION_SECRET=replace-this-with-a-long-random-secret
SESSION_TABLE_NAME=session

# Number of days used as the reference window for restock recommendation (FR-21)
RESTOCK_DAYS=14
